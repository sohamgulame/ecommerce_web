### ============================================================
### 6. CART OPERATIONS (Customer 1)
### ============================================================

### 6.1 View initial cart (should be empty)
GET {{baseUrl}}/cart
Authorization: Bearer {{customer1Token}}

### 6.2 Add main product to cart — captures cartItemId
POST {{baseUrl}}/cart/items
Content-Type: application/json
Authorization: Bearer {{customer1Token}}

{
  "productId": {{productId}},
  "quantity": 2
}

> {%
    client.test("Product added to cart", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.items.length > 0, "Cart items array is empty");
    });
    client.global.set("cartItemId", response.body.items[0].id);
%}

### 6.3 Try to add quantity exceeding available stock — expect 400 Bad Request
POST {{baseUrl}}/cart/items
Content-Type: application/json
Authorization: Bearer {{customer1Token}}

{
  "productId": {{lowStockProductId}},
  "quantity": 999
}

> {%
    client.test("Excessive quantity rejected with 400", function() {
        client.assert(response.status === 400, "Expected 400 Bad Request");
    });
%}

### 6.4 Add valid quantity of low-stock product
POST {{baseUrl}}/cart/items
Content-Type: application/json
Authorization: Bearer {{customer1Token}}

{
  "productId": {{lowStockProductId}},
  "quantity": 1
}

### 6.5 View populated cart with items and total calculation
GET {{baseUrl}}/cart
Authorization: Bearer {{customer1Token}}

> {%
    client.test("Cart total calculation verified", function() {
        client.assert(response.body.items.length === 2, "Expected 2 cart items");
        client.assert(response.body.totalAmount > 0, "Total amount should be positive");
    });
%}

### 6.6 Update cart item quantity
PUT {{baseUrl}}/cart/items/{{cartItemId}}
Content-Type: application/json
Authorization: Bearer {{customer1Token}}

{
  "quantity": 3
}

### 6.7 Cross-User Cart Isolation: Customer 2 tries modifying Customer 1's cart item — expect 404
PUT {{baseUrl}}/cart/items/{{cartItemId}}
Content-Type: application/json
Authorization: Bearer {{customer2Token}}

{
  "quantity": 1
}

> {%
    client.test("Cross-user cart manipulation blocked", function() {
        client.assert(response.status === 404 || response.status === 403, "Expected 404 or 403 on foreign cart item");
    });
%}


### ============================================================
### 7. ORDERS & CHECKOUT (Customer 1)
### ============================================================

### 7.1 Place order from current cart — captures orderId
POST {{baseUrl}}/orders
Authorization: Bearer {{customer1Token}}

> {%
    client.global.set("orderId", response.body.id);
    client.test("Order placed successfully with snapshot lines", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201");
        client.assert(response.body.id, "Order ID missing");
        client.assert(response.body.status === "PLACED", "Initial status should be PLACED");
        client.assert(response.body.items.length > 0, "Order items missing");
    });
%}

### 7.2 Try placing another order immediately (Cart is now empty) — expect 400 Bad Request
POST {{baseUrl}}/orders
Authorization: Bearer {{customer1Token}}

> {%
    client.test("Checkout on empty cart rejected with 400", function() {
        client.assert(response.status === 400, "Expected 400 Empty Cart Error");
    });
%}

### 7.3 View customer order history (paginated)
GET {{baseUrl}}/orders?page=0&size=10
Authorization: Bearer {{customer1Token}}

### 7.4 View specific order by ID (Owner)
GET {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{customer1Token}}

> {%
    client.test("Owner can view own order", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.id === client.global.get("orderId"), "Order ID mismatch");
    });
%}

### 7.5 🔒 IDOR Security Check: Customer 2 tries accessing Customer 1's Order — expect 404
GET {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{customer2Token}}

> {%
    client.test("IDOR access blocked for foreign order", function() {
        client.assert(response.status === 404 || response.status === 403, "Expected 404/403 for unauthorized order access");
    });
%}


### ============================================================
### 8. ADMIN — ORDER MANAGEMENT & STATE MACHINE
### ============================================================

### 8.1 Admin views all customer orders
GET {{baseUrl}}/admin/orders?page=0&size=20
Authorization: Bearer {{adminToken}}

### 8.2 Admin filters orders by PLACED status
GET {{baseUrl}}/admin/orders?status=PLACED
Authorization: Bearer {{adminToken}}

### 8.3 State Machine Step 1: PLACED → CONFIRMED (Valid Transition)
PUT {{baseUrl}}/admin/orders/{{orderId}}/status?newStatus=CONFIRMED
Authorization: Bearer {{adminToken}}

> {%
    client.test("Status transition to CONFIRMED succeeded", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.status === "CONFIRMED", "Expected CONFIRMED status");
    });
%}

### 8.4 State Machine Step 2: Invalid Jump (CONFIRMED → DELIVERED without SHIPPED) — expect 409 Conflict
PUT {{baseUrl}}/admin/orders/{{orderId}}/status?newStatus=DELIVERED
Authorization: Bearer {{adminToken}}

> {%
    client.test("Illegal status jump rejected with 409", function() {
        client.assert(response.status === 409, "Expected 409 Conflict on invalid state jump");
    });
%}

### 8.5 State Machine Step 3: CONFIRMED → SHIPPED (Valid Transition)
PUT {{baseUrl}}/admin/orders/{{orderId}}/status?newStatus=SHIPPED
Authorization: Bearer {{adminToken}}

> {%
    client.test("Status transition to SHIPPED succeeded", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.status === "SHIPPED", "Expected SHIPPED status");
    });
%}

### 8.6 State Machine Step 4: SHIPPED → DELIVERED (Valid Final Transition)
PUT {{baseUrl}}/admin/orders/{{orderId}}/status?newStatus=DELIVERED
Authorization: Bearer {{adminToken}}

> {%
    client.test("Status transition to DELIVERED succeeded", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.status === "DELIVERED", "Expected DELIVERED status");
    });
%}


