Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "otp": "000000"
}

> {%
    client.test("Invalid OTP rejected with 400", function() {
        client.assert(response.status === 400, "Expected 400 Bad Request");
    });
%}

