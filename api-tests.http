### ============================================================
### 4. ADMIN — CATEGORY & PRODUCT MANAGEMENT
### ============================================================

### 4.1 Create category as Admin — captures categoryId
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Peripherals & Accessories",
  "description": "Keyboards, mice, headsets, and computer accessories"
}

> {%
    client.global.set("categoryId", response.body.id);
    client.test("Category created successfully", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201");
        client.assert(response.body.id, "Category ID missing");
    });
%}

### 4.2 Create duplicate category name — expect 409 Conflict
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Peripherals & Accessories",
  "description": "Duplicate category attempt"
}

> {%
    client.test("Duplicate category rejected with 409", function() {
        client.assert(response.status === 409, "Expected 409 Conflict");
    });
%}

### 4.3 Create main product as Admin — captures productId
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Pro Ergonomic Wireless Mouse",
  "description": "High precision wireless mouse with rechargeable battery",
  "price": 1499.00,
  "stockQuantity": 15,
  "categoryId": {{categoryId}},
  "imageUrls": ["https://images.unsplash.com/photo-1527864550417-7fd91fc51a46"]
}

> {%
    client.global.set("productId", response.body.id);
    client.test("Product created successfully", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201");
        client.assert(response.body.id, "Product ID missing");
    });
%}

### 4.4 Create low-stock product — captures lowStockProductId (for stock limit testing)
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Mechanical Gaming Keyboard RGB",
  "description": "Compact mechanical keyboard with blue switches (Limited Edition)",
  "price": 3499.00,
  "stockQuantity": 2,
  "categoryId": {{categoryId}}
}

> {%
    client.global.set("lowStockProductId", response.body.id);
    client.test("Low stock product created", function() {
        client.assert(response.body.id, "Low stock product ID missing");
    });
%}

### 4.5 Update product details as Admin
PUT {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Pro Ergonomic Wireless Mouse (V2)",
  "description": "Upgraded precision optical sensor and silent clicks",
  "price": 1299.00,
  "stockQuantity": 15,
  "categoryId": {{categoryId}}
}

> {%
    client.test("Product updated successfully", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.name.includes("V2"), "Product name did not update");
    });
%}


### 4.6 Upload standalone image to Cloudinary (Admin only)
POST {{baseUrl}}/files/upload
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="mouse.png"
Content-Type: image/png

< ./src/main/resources/application.properties
--boundary--

> {%
    client.test("File upload endpoint reached", function() {
        // Will return 200 with imageUrl if Cloudinary credentials configured, or 400/500 if unconfigured
        client.assert(response.status === 200 || response.status === 400 || response.status === 500);
    });
%}

### 4.7 Upload product image by Product ID (Admin only)
POST {{baseUrl}}/products/{{productId}}/images
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="mouse.jpg"
Content-Type: image/jpeg

< ./src/main/resources/application.properties
--boundary--

### 4.8 Delete product image by URL (Admin only)
DELETE {{baseUrl}}/products/{{productId}}/images?imageUrl=https://res.cloudinary.com/demo/image/upload/sample.jpg
Authorization: Bearer {{adminToken}}


