### ============================================================
### E-commerce API — Full Flow Test (IntelliJ HTTP Client)
###
### Uses IntelliJ's response-handler script syntax
### ( > {% client.global.set("name", value); %} )
### to chain tokens/IDs between requests — NOT the
### {{requestName.response.body.$.field}} syntax, which
### IntelliJ's HTTP Client does not support.
###
### Setup: this file expects an environment named "dev" (see
### http-client.env.json) providing {{baseUrl}}. Select it from
### the environment dropdown in the top-right of this editor
### before running anything.
###
### Run requests TOP TO BOTTOM — later ones depend on global
### variables set by earlier ones via client.global.set().
### ============================================================

@customerEmail = customer1@test.com
@customerPassword = password123
@customer2Email = customer2@test.com
@customer2Password = password123
@adminEmail = admin@test.com
@adminPassword = adminpass123

### ------------------------------------------------------------
### ⚠️ ADMIN SETUP — READ FIRST
### ------------------------------------------------------------
### There is no public API endpoint to assign ADMIN role directly.
### /auth/register always assigns ROLE_CUSTOMER.
### To test admin requests:
###   1. Run request 1.3 ("Register admin user") below once.
###   2. Promote that user in MySQL:
###        UPDATE users SET role = 'ROLE_ADMIN' WHERE email = 'admin@test.com';
###   3. Run request 1.7 ("Login as admin") to get a JWT token
###      carrying the real ROLE_ADMIN claim.
### ------------------------------------------------------------


### ============================================================
### 0. HEALTH CHECK
### ============================================================

### 0.1 Health check — expect 200, public
GET {{baseUrl}}/health

> {%
    client.test("Health check returned 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}


### ============================================================
### 1. AUTHENTICATION & FULL TOKEN LIFECYCLE
### ============================================================

### 1.1 Register customer 1 — captures customer1Token & customer1RefreshToken
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test Customer One",
  "email": "{{customerEmail}}",
  "password": "{{customerPassword}}",
  "phone": "9990001111",
  "address": "123 Test Street"
}

> {%
    if (response.body.accessToken) {
        client.global.set("customer1Token", response.body.accessToken);
        client.global.set("customer1RefreshToken", response.body.refreshToken);
    }
    client.test("Customer 1 registration status", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201 on register");
    });
%}

### 1.2 Register customer 2 (used for IDOR / ownership & logout testing)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test Customer Two",
  "email": "{{customer2Email}}",
  "password": "{{customer2Password}}",
  "phone": "9990002222",
  "address": "456 Test Avenue"
}

> {%
    if (response.body.accessToken) {
        client.global.set("customer2Token", response.body.accessToken);
        client.global.set("customer2RefreshToken", response.body.refreshToken);
    }
%}

### 1.3 Register admin user
### ⚠️ After this succeeds, run: UPDATE users SET role = 'ROLE_ADMIN' WHERE email = 'admin@test.com';
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test Admin",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "phone": "9990003333",
  "address": "789 Admin Blvd"
}

### 1.4 Register with a duplicate email — expect 409 Conflict
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Duplicate Attempt",
  "email": "{{customerEmail}}",
  "password": "somepassword",
  "phone": "0000000000",
  "address": "N/A"
}

> {%
    client.test("Duplicate registration returns 409", function() {
        client.assert(response.status === 409, "Expected 409 Conflict");
    });
%}

### 1.5 Login as customer 1 — updates customer1Token & customer1RefreshToken
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "{{customerPassword}}"
}

> {%
    client.global.set("customer1Token", response.body.accessToken);
    client.global.set("customer1RefreshToken", response.body.refreshToken);
    client.test("Login customer1 succeeded", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.accessToken, "accessToken missing");
        client.assert(response.body.refreshToken, "refreshToken missing");
    });
%}

### 1.6 Login as customer 2 — updates customer2Token & customer2RefreshToken
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{customer2Email}}",
  "password": "{{customer2Password}}"
}

> {%
    client.global.set("customer2Token", response.body.accessToken);
    client.global.set("customer2RefreshToken", response.body.refreshToken);
%}

### 1.7 Login as admin — captures adminToken & adminRefreshToken
### (Run AFTER setting role='ROLE_ADMIN' in DB)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.global.set("adminToken", response.body.accessToken);
    client.global.set("adminRefreshToken", response.body.refreshToken);
    client.test("Admin login succeeded", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.accessToken, "accessToken missing");
    });
%}

### 1.8 Refresh Token Rotation — exchange customer1RefreshToken for new token pair
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{customer1RefreshToken}}"
}

> {%
    client.test("Refresh token rotated successfully", function() {
        client.assert(response.status === 200, "Expected 200 on refresh");
        client.assert(response.body.accessToken, "New accessToken missing");
        client.assert(response.body.refreshToken, "New refreshToken missing");
    });
    // Save newly rotated tokens
    client.global.set("customer1Token", response.body.accessToken);
    client.global.set("customer1OldRefreshToken", client.global.get("customer1RefreshToken"));
    client.global.set("customer1RefreshToken", response.body.refreshToken);
%}

### 1.9 Re-use Old (Rotated) Refresh Token — expect 400 / 401 Bad Request
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{customer1OldRefreshToken}}"
}

> {%
    client.test("Re-used refresh token rejected", function() {
        client.assert(response.status === 400 || response.status === 401, "Expected 400 or 401 on reused token");
    });
%}

### 1.10 Server-Side Logout — Revoke customer 2's refresh token
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{customer2RefreshToken}}"
}

> {%
    client.test("Logout succeeded", function() {
        client.assert(response.status === 200, "Expected 200 on logout");
    });
%}

### 1.11 Try to Refresh with Revoked Token (Customer 2) — expect 400 / 401
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{customer2RefreshToken}}"
}

> {%
    client.test("Revoked refresh token rejected", function() {
        client.assert(response.status === 400 || response.status === 401, "Expected 400/401 on revoked token");
    });
%}

### 1.12 Re-authenticate Customer 2 (to restore active customer2Token for later tests)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{customer2Email}}",
  "password": "{{customer2Password}}"
}

> {%
    client.global.set("customer2Token", response.body.accessToken);
    client.global.set("customer2RefreshToken", response.body.refreshToken);
%}

### 1.13 Login with invalid password — expect 401 Unauthorized
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "wrong-password-here"
}

> {%
    client.test("Wrong credentials rejected with 401", function() {
        client.assert(response.status === 401, "Expected 401 Unauthorized");
    });
%}

