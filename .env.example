# =========================================================================
# E-Commerce Application Environment Variables Template (.env)
# Copy this file to .env and fill in your custom values
# =========================================================================

# Database Configuration
DB_NAME=projectdb
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_HOST=mysql
DB_PORT=3306

# JWT Authentication
JWT_SECRET=eCommerceSuperSecretKeyForJWTTokenSigning2026AtLeast256BitsLong
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL=600000

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email & SMTP Notifications (Optional)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=noreply@ecommerce.local
OTP_EXPIRATION_MINUTES=15

# Order Auto-Cancellation
ORDER_AUTO_CANCEL_HOURS=24
ORDER_AUTO_CANCEL_CRON=0 */30 * * * ?

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173
